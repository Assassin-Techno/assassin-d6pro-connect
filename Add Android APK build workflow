
name: Build Assassin D6 Pro APK

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Android SDK
        uses: android-actions/setup-android@v3

      - name: Install SDK
        run: sdkmanager "platforms;android-35" "build-tools;35.0.0"

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.9"

      - name: Extract Android project
        run: |
          mkdir buildsrc
          unzip Assassin_D6Pro_Connect_Smartphone_CloudBuild.zip -d buildsrc

      - name: Build APK
        run: |
          cd buildsrc/Assassin_D6Pro_Connect
          gradle --no-daemon assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Assassin-D6Pro-Connect-APK
          path: buildsrc/Assassin_D6Pro_Connect/app/build/outputs/apk/debug/app-debug.apk
          retention-days: 14
